<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>J.A.R.V.I.S. Tactical HUD</title>
    <style>
        :root {
            --bg-color: #050b14;
            --glow-cyan: #00f3ff;
            --glow-orange: #ff9d00;
            --dim-cyan: rgba(0, 243, 255, 0.2);
            --line-color: rgba(0, 243, 255, 0.4);
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: var(--bg-color);
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Courier New', Courier, monospace;
        }

        #hud-wrapper {
            position: relative;
            width: 100vmin;
            height: 100vmin;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .grid-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                radial-gradient(circle, var(--dim-cyan) 1px, transparent 1px),
                linear-gradient(to right, var(--line-color) 1px, transparent 1px),
                linear-gradient(to bottom, var(--line-color) 1px, transparent 1px);
            background-size: 50px 50px, 50px 50px, 50px 50px;
            opacity: 0.3;
            pointer-events: none;
        }

        .central-core {
            width: 30vmin;
            height: 30vmin;
            border-radius: 50%;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            background: radial-gradient(circle, #ffe600 0%, #ff6f00 40%, #990000 100%);
            box-shadow: 0 0 50px #ff6f00, inset 0 0 30px #ffffff;
            animation: heartbeat 2s infinite ease-in-out;
        }

        @keyframes heartbeat {
            0% { transform: scale(1); box-shadow: 0 0 30px #ff6f00; }
            15% { transform: scale(1.15); box-shadow: 0 0 80px #ff3b00; }
            30% { transform: scale(1.02); box-shadow: 0 0 40px #ff6f00; }
            45% { transform: scale(1.12); box-shadow: 0 0 70px #ff3b00; }
            60% { transform: scale(1); box-shadow: 0 0 30px #ff6f00; }
            100% { transform: scale(1); box-shadow: 0 0 30px #ff6f00; }
        }

        .orbit-ring {
            position: absolute;
            border: 2px solid var(--glow-cyan);
            border-radius: 50%;
            pointer-events: none;
            box-sizing: border-box;
        }

        .ring-1 {
            width: 50vmin;
            height: 50vmin;
            border-color: var(--glow-cyan);
            animation: spin-clockwise 12s linear infinite;
            border-dasharray: 20 40 10 40;
        }

        .ring-2 {
            width: 70vmin;
            height: 70vmin;
            border-color: var(--glow-orange);
            animation: spin-counter 18s linear infinite;
            border-dasharray: 100 20 10 20;
        }

        .ring-3 {
            width: 90vmin;
            height: 90vmin;
            border-color: var(--dim-cyan);
            animation: spin-clockwise 25s linear infinite;
        }

        @keyframes spin-clockwise {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @keyframes spin-counter {
            0% { transform: rotate(360deg); }
            100% { transform: rotate(0deg); }
        }

        .satellite {
            position: absolute;
            width: 15px;
            height: 15px;
            background-color: var(--glow-cyan);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--glow-cyan);
            top: 50%;
            left: 0;
            transform-origin: 35vmin 50%;
            animation: orbit-node 8s linear infinite;
        }

        .satellite-2 {
            width: 10px;
            height: 10px;
            background-color: var(--glow-orange);
            box-shadow: 0 0 15px var(--glow-orange);
            transform-origin: 45vmin 50%;
            animation: orbit-node 15s linear infinite reverse;
        }

        @keyframes orbit-node {
            0% { transform: rotate(0deg) translateX(35vmin) rotate(0deg); }
            100% { transform: rotate(360deg) translateX(35vmin) rotate(-360deg); }
        }

        .hud-text {
            position: absolute;
            color: var(--glow-cyan);
            font-size: 1.2vmin;
            text-shadow: 0 0 5px var(--glow-cyan);
            letter-spacing: 2px;
        }

        .t-top-left { top: 10%; left: 10%; }
        .t-top-right { top: 10%; right: 10%; }
        .t-bottom-left { bottom: 10%; left: 10%; }
        .t-bottom-right { bottom: 10%; right: 10%; }

        .scan-line {
            position: absolute;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--glow-cyan), transparent);
            opacity: 0.7;
            animation: scan 4s ease-in-out infinite;
        }

        @keyframes scan {
            0% { top: 0%; }
            50% { top: 100%; }
            100% { top: 0%; }
        }

        .crosshair {
            position: absolute;
            width: 2vmin;
            height: 2vmin;
            pointer-events: none;
        }
        .crosshair::before, .crosshair::after {
            content: '';
            position: absolute;
            background-color: var(--glow-cyan);
        }
        .crosshair::before { top: 50%; left: 0; width: 100%; height: 1px; }
        .crosshair::after { top: 0; left: 50%; width: 1px; height: 100%; }
        
        .c-1 { top: 35%; left: 30%; }
        .c-2 { bottom: 30%; right: 25%; }

    </style>
</head>
<body>

    <div id="hud-wrapper">
        <div class="grid-overlay"></div>
        <div class="scan-line"></div>

        <div class="orbit-ring ring-3"></div>
        <div class="orbit-ring ring-2"></div>
        <div class="orbit-ring ring-1"></div>
        
        <div class="satellite"></div>
        <div class="satellite satellite-2"></div>

        <div class="central-core"></div>

        <div class="crosshair c-1"></div>
        <div class="crosshair c-2"></div>

        <div class="hud-text t-top-left">SYS_PWR: 109.4 GW<br>CORE_TEMP: 3400K</div>
        <div class="hud-text t-top-right">THREAT_LVL: ZERO<br>LOC: 1.3481 N, 36.8219 E</div>
        <div class="hud-text t-bottom-left">STABILIZATION: 99.8%<br>SYNC: SATELLITE_LINK</div>
        <div class="hud-text t-bottom-right">STATUS: ONLINE<br>MODE: TACTICAL_HUD</div>
    </div>

</body>
</html>
