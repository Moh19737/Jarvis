<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>J.A.R.V.I.S. OS</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: #0d1117;
            color: #58a6ff;
            font-family: 'Courier New', Courier, monospace;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }
        #hud-container {
            text-align: center;
            border: 2px solid #1f6feb;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 15px rgba(31, 111, 235, 0.5);
            max-width: 80%;
        }
        h1 {
            margin: 0 0 10px 0;
            font-size: 2rem;
            text-shadow: 0 0 8px #58a6ff;
        }
        p {
            font-size: 1.2rem;
            color: #8b949e;
        }
    </style>
</head>
<body>
    <div id="hud-container">
        <h1>J.A.R.V.I.S. OS</h1>
        <p id="status">Initializing neural network...</p>
    </div>

    <script>
        window.onload = function() {
            setTimeout(function() {
                document.getElementById('status').innerText = "Systems Operational, Sir.";
                if ('speechSynthesis' in window) {
                    const utterance = new SpeechSynthesisUtterance("Systems Operational, Sir.");
                    utterance.rate = 0.9;
                    utterance.pitch = 0.8;
                    window.speechSynthesis.speak(utterance);
                }
            }, 1000);
        };
    </script>
</body>
</html>
